{
  "name": "resort-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"PORT=5001 VITE_API_PORT=5001 npm run server\" \"VITE_API_PORT=5001 vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview --host",
    "server": "node server/server.js",
    "dev:all": "npm run dev",
    "db:setup": "node scripts/apply-supabase-schema.js",
    "provision:admin": "node scripts/provision-super-admin.js",
    "test": "NODE_ENV=test node --test tests/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.10"
  }
}
